# ---------------------------------------------------------------------------
# Copy to `.env` and replace every secret before exposing the service.
# `docker compose up -d` reads this file. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL (kept private to the Docker network) ---
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tracker:change-me@postgres:5432/tracker?schema=public

# --- Authentication secrets ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# A "Remember me" sign-in is capped at this many days, counted from the
# original login rather than renewed on each refresh.
REMEMBER_ME_DAYS=1

# --- Ports / origins ---
API_PORT=5789
FRONTEND_PORT=5788
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5788
# Leave empty to serve the API through the frontend's nginx reverse proxy (same origin).
VITE_API_URL=

# --- Branding defaults (used only when an organization has no branding yet) ---
DEFAULT_APPLICATION_NAME=COMPANY TRACKER
DEFAULT_COMPANY_NAME=COMPANY
DEFAULT_TIMEZONE=UTC
DEFAULT_COUNTRY=

# --- Development seed (optional; `npm run seed`) ---
# There is NO default administrator in production. Prefer the first-run setup wizard.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_ORG_SLUG=default

# --- Silent-device watchdog ---
# The server cannot be told by the phone that it has died, so it watches for
# phones that stop reporting. Only a device that was demonstrably working
# recently is eligible, and each is reported at most once per dedupe window, so
# a phone switched off for the weekend does not raise an alert every scan.
WATCHDOG_SILENCE_MINUTES=30
WATCHDOG_ELIGIBLE_DAYS=7
WATCHDOG_DEDUPE_HOURS=6
WATCHDOG_INTERVAL_MINUTES=15

NODE_ENV=production
